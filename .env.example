# ============================================================
# Google Cloud Platform Configuration
# ============================================================
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GCP_REGION=asia-south2
FIRESTORE_DATABASE_ID=(default)
COLLECTION_NAME=website_monitoring

# ============================================================
# Alerting Configuration
# ============================================================
GMAIL_SENDER=your-monitoring-email@gmail.com
GMAIL_SENDER_NAME="Website Operations Monitor"
ALERT_RECIPIENTS=your-alert-inbox@gmail.com,devops@yourcompany.com

# ============================================================
# Gmail OAuth 2.0 Credentials (From Google Cloud Credentials)
# ============================================================
GMAIL_OAUTH_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GMAIL_OAUTH_CLIENT_SECRET=your-oauth-client-secret
GMAIL_OAUTH_REFRESH_TOKEN=your-generated-refresh-token
GMAIL_OAUTH_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google

# ============================================================
# Operational Enhancements (Optional)
# ============================================================
# Heartbeat URL for external "Monitor the Monitor" (e.g., Better Stack / Cronitor / Healthchecks.io)
HEARTBEAT_URL=

# SSL certificate expiration warning threshold in days (default: 14)
SSL_EXPIRY_THRESHOLD_DAYS=14

# Live operations dashboard URL (Cloud Run service URL)
DASHBOARD_URL=
